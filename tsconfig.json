{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": true, "types": ["node", "vite/client"]
  },
  "include": ["src", "scripts", "tests", "playwright.config.ts", "vite.config.ts"]
}
